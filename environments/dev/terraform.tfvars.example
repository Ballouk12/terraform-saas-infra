# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars itself to version control (add it to .gitignore).

project_name = "AAAAAAA"
environment  = "dev"
aws_region   = "eu-west-1"

vpc_cidr                = "10.0.0.0/16"
availability_zone_count = 3

domain_name          = "binaitech.com"
acm_certificate_arn  = "arn:aws:acm:eu-west-3:123456789012:certificate/REPLACE-ME"

app_ami_id         = "ami-REPLACE-ME"
app_instance_type  = "t3.medium"
key_name            = null

db_username = "AAAAA"

alert_emails = ["AAAA@gmail.com"]

asg_min_size         = 2
asg_max_size          = 4
asg_desired_capacity  = 2
