project_name = "binaitech"
environment  = "staging"
aws_region   = "eu-west-1"

vpc_cidr                = "10.2.0.0/16"
availability_zone_count = 3

domain_name          = "binaitech.com"
acm_certificate_arn  = "arn:aws:acm:eu-west-1:123456789012:certificate/REPLACE-ME"

app_ami_id         = "ami-REPLACE-ME"
app_instance_type  = "t3.medium"
key_name            = null

db_username = "binaitech_admin"

alert_emails = ["devops@binaitech.com"]

asg_min_size         = 2
asg_max_size          = 4
asg_desired_capacity  = 2
