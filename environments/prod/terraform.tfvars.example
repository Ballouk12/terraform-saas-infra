project_name = "binaitech"
environment  = "prod"
aws_region   = "eu-west-3"

vpc_cidr                = "10.1.0.0/16"   # distinct range from dev/staging to allow future VPC peering
availability_zone_count = 3

domain_name          = "binaitech.com"
acm_certificate_arn  = "arn:aws:acm:eu-west-3:123456789012:certificate/REPLACE-ME"

app_ami_id         = "ami-REPLACE-ME"
app_instance_type  = "t3.large"     # larger than dev — real production load
key_name            = null

db_username = "binaitech_admin"

alert_emails = ["mhbloctobre@gmail.com", "mohamedballouk165@gmail.com"]

asg_min_size         = 3    # 3 for prod: survives losing one AZ and still has 2 healthy instances
asg_max_size          = 20
asg_desired_capacity  = 3
